# ==============================================================================
# SUPABASE POSTGRESQL CONNECTION STRINGS (Production & 200 Concurrent Users)
# ==============================================================================
#
# 1. DATABASE_URL: Supabase Transaction Pooler (Port 6543)
#    CRITICAL: This allows hundreds of concurrent AWS Lambda instances to share connections
#    without exceeding PostgreSQL's max_connections limit.
#    Find in Supabase: Project Settings -> Database -> Connection String -> URI (Mode: Session/Transaction Pooler)
#
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

#
# 2. DIRECT_URL: Supabase Direct Connection (Port 5432)
#    Used by Prisma CLI for `prisma db push` and schema synchronization.
#    Find in Supabase: Project Settings -> Database -> Connection String -> URI (Mode: Direct)
#
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
